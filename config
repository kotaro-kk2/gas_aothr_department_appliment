/**
 * 他部門稼働 申請・承認・成果報告（職務権限 No.43）
 * マスタ版：申請者と承認者を、シート「マスタ」で管理する
 *
 * しくみ
 *   申請フォーム → シート「申請回答」
 *     ・回答者のメールアドレスから、マスタで申請者名を補完する
 *     ・申請者が選んだ本部の「承認者」に、Chatworkで承認依頼を送る
 *   承認 → 申請回答シートの「承認ステータス」をプルダウンで選ぶ
 *     ・ONLY_MASTER_APPROVER が true なら、その本部の承認者（マスタに登録された人）だけが有効
 *   成果報告フォーム → シート「成果回答」 → 申請回答シートに転記して共有
 *   毎朝 → 成果報告が遅れているものを督促
 *
 * 初回の手順
 *   1. 下の「フォームの設問名」（F と R）に、実際のフォームの設問名を入力する
 *   2. setup を実行する（「マスタ」シートがなければ、見出し付きで作って止まる）
 *   3. 「マスタ」シートに申請者と承認者を入力し、もう一度 setup を実行する
 *   4. Chatworkを使うときは、スクリプト プロパティに CHATWORK_TOKEN と CHATWORK_ROOM_ID を登録
 *      （任意）CHATWORK_TO にアカウントIDを入れると、全通知の先頭にその人あてのTOが付く（テスト用）
 */

// ===== 設定 =====
const CONFIG = {
  // この時間「以下」の申請は承認不要（届出のみ）。0 なら全件で承認が必要
  NO_APPROVAL_MAX_HOURS: 0,
  // 稼働終了日から何日たっても成果が未入力なら督促するか
  REMIND_AFTER_DAYS: 3,
  // 督促を送る時刻（時）
  REMIND_HOUR: 9,
  // true：申請者の本部の承認者（マスタで区分が「承認者」の人）だけが承認・却下できる
  // false：申請者本人以外なら誰でも承認・却下できる（操作した人の記録は残る）
  ONLY_MASTER_APPROVER: true,
  // 申請回答シートで、承認列のプルダウンと保護を用意しておく行数
  PREPARED_ROWS: 2000,
  TIMEZONE: 'Asia/Tokyo',
  SHEET_APPLY: '申請回答',
  SHEET_RESULT: '成果回答',
  // 稼働期間の上限（営業日）。土日と祝日を除いて数える。0 なら上限なし
  MAX_BUSINESS_DAYS: 5,  
  SKIP_HOLIDAYS: true,
  HOLIDAY_CALENDAR_ID: 'ja.japanese#holiday@group.v.calendar.google.com',
  // Chatworkに送れなかった通知を記録するシート
  SHEET_ERROR: '通知エラー',
  // 管理者（承認後の変更・代理の成果報告ができる人）のメールアドレス
  ADMIN_EMAILS: ['kanri@〇〇.co.jp'],
};
//===通知on/off====
const NOTIFY = {
  '承認依頼': true,
  '承認': true,
  '却下': true,
  '修正': true,
  '成果報告': true,
  '督促': true,
};


// ===== フォームの設問名（ここに、実際のフォームの設問名をそのまま入力する） =====
// ' と ' の間に、フォームの設問名を1文字も違わず入れる（シートの1行目からコピーすると確実）
// 「必須」の項目が空のままだと、setup とフォーム送信時にエラーで知らせる

// 申請フォーム（＝申請回答シートの見出し）
const F = {
  TIMESTAMP: 'タイムスタンプ',   // フォームが自動で作る列（通常は変更不要）
  EMAIL: 'メールアドレス',       // 「メールアドレスを収集する」で自動で作られる列（通常は変更不要）
  APPLY_HONBU: '申請者所属本部',               // 必須：申請者の所属本部（ラジオボタン。選択肢はマスタの本部名と同じ文字にする）
  MEMBER: '稼働予定メンバー',                    // 必須：稼働させたいメンバー
  TARGET_HONBU: '申請先本部',              // 任意：稼働メンバーの所属本部（空なら、稼働先の本部への通知はしない）
  START: '稼働開始予定日',                     // 必須：稼働開始日（「日付」の設問）
  END: '稼働終了予定日',                       // 必須：稼働終了日（「日付」の設問）
  HOURS: '',                     // 必須：予定時間（数字だけの回答）
  PURPOSE: '目的・期待する成果',                   // 任意：目的・期待する成果
};

// 成果報告フォーム（＝成果回答シートの見出し）
const R = {
  EMAIL: 'メールアドレス',       // 自動で作られる列（通常は変更不要）
  ID: '管理ID',                        // 必須：管理ID（記述式。通知のリンクから開くと入力済みになる）
  ACTUAL: '実績日数',                    // 必須：実績日数（数字だけの回答）
  RESULT: '成果内容',                   // 必須：成果内容
  BIKOU: '成果備考',                   // 必須：成果備考欄
};

const REQUIRED_F = ['APPLY_HONBU', 'MEMBER', 'START', 'END'];
const REQUIRED_R = ['ID', 'ACTUAL', 'RESULT'];


// ===== マスタ（申請者・承認者の一覧） =====
// シート「マスタ」の1行目の見出しと、区分に入れる言葉
const MASTER = {
  SHEET: '申請者・承認者リスト',
  ROLE: '区分',                  // 「申請者」か「承認者」
  HONBU: '本部名',               // 申請フォームの本部の選択肢と同じ文字にする
  NAME: '名前',
  MAIL: 'mail',                  // フォームで収集されるメールアドレスと同じもの
  CW_ID: 'chatwork_account_ID',  // ChatworkのアカウントID（数字）。空ならメンションなしで名前だけ通知
  APPLICANT: '申請者',
  APPROVER: '承認者',
};


// ===== 通知ごとのメンション先 =====
// 使える言葉：'申請者'（申請した人）／'承認者'（申請者の本部の承認者）／'稼働先承認者'（稼働先の本部の承認者）
const MENTIONS = {
  '承認依頼': ['承認者'],
  '承認不要': ['承認者', '稼働先承認者', '申請者'],
  '承認': ['申請者', '稼働先承認者'],
  '却下': ['申請者'],
  '成果報告': ['承認者', '稼働先承認者'],
  '督促': ['申請者'],
    '修正': ['申請者'],
};


// ===== 通知の文面（ここの日本語を書き換えれば、Chatworkの文面が変わる） =====
//   ・` と ` の間は自由に書き換えられる。改行もそのまま反映される（行頭の空白も文面に入る）
//   ・{ } で囲んだ部分には、申請の内容が自動で入る。{ } は必ず半角で書く
//   ・先頭のメンション（[To:ID]名前さん）と、枠（[info]）・見出し（[title]）は自動で付く
//   ・名前の差し込みには「さん」が付かないので、文面側で付ける。承認者が複数なら「佐藤・鈴木」のように並ぶ
//   使える差し込み：
//     {管理ID} {申請者名} {申請者メール} {申請本部} {承認者名}
//     {稼働メンバー} {稼働先本部} {稼働先承認者名}
//     {開始日} {終了日} {予定時間} {目的} {概要}
//     {承認した人} {却下理由} {実績日数} {成果内容} {成果報告URL}
//     {シートのリンク}（承認依頼だけ）　{件数}（督促のタイトルと前置きだけ）
//     {再提出}（成果報告だけ）　{注意書き}（承認依頼・承認不要・成果報告。問題があるときだけ注意の行が入る）
const MESSAGES = {
  // すべての通知に入る共通の数行。{概要} と書いた場所に入る
  '概要': `申請者：{申請者名}（{申請本部}）
稼働メンバー：{稼働メンバー}（{稼働先本部}）
期間：{開始日}〜{終了日}`,

  '承認依頼': {
    'タイトル': '【承認依頼】他部門稼働 {管理ID}',
    '本文': `{承認者名}さん、{申請者名}さんから承認依頼です。{注意書き}

{概要}
目的：{目的}

▼シートの「承認ステータス」で「承認」か「却下」を選んでください（却下のときは先に「却下理由」を記入）
{シートのリンク}`,
  },

  '承認不要': {
    'タイトル': '【稼働のお知らせ】他部門稼働 {管理ID}（権限内のため承認不要）',
    '本文': `{申請者名}さんの稼働の届出です。{注意書き}

{概要}
目的：{目的}

▼稼働後の成果報告フォーム
{成果報告URL}`,
  },

  '承認': {
    'タイトル': '【承認】他部門稼働 {管理ID}',
    '本文': `{申請者名}さん、{稼働先承認者名}さん、{稼働メンバー}さんの稼働が承認されました。

{概要}
承認した人：{承認した人}

▼稼働後の成果報告フォーム（管理IDは入力済み）
{成果報告URL}`,
  },

  '却下': {
    'タイトル': '【却下】他部門稼働 {管理ID}',
    '本文': `{申請者名}さん、申請は却下されました。

{概要}
却下理由：{却下理由}
対応した人：{承認した人}`,
  },

  // {再提出} は2回目以降の報告のときだけ「（再提出）」になる
  '成果報告': {
    'タイトル': '【成果報告{再提出}】他部門稼働 {管理ID}',
    '本文': `{申請者名}さんから、{稼働メンバー}さんの稼働成果の報告です。{注意書き}

{概要}
実績日数：{実績日数}
成果：{成果内容}
成果備考：{成果備考}`,
  },

  // 稼働終了から日数がたっても成果報告がないものだけ。「行」は1件ごとに繰り返される
  '督促': {
    'タイトル': '【督促】成果報告がまだの他部門稼働（{件数}件）',
    '前置き': '稼働終了から日数がたっていますが、成果報告が届いていません。下のリンクから報告をお願いします。',
    '行': `・{管理ID}　{申請者名}さん：{稼働メンバー}（{稼働先本部}）稼働終了 {終了日}
　{成果報告URL}`,
  },
  
  '修正': {
    'タイトル': '【修正依頼】他部門稼働 {管理ID}',
    '本文': `{申請者名}さん、申請内容の修正をお願いします。
直してほしい点：{理由}

{概要}

内容を直して、申請フォームから新しく申請し直してください（この申請はここで終わりです）。`,
  },
  
};
