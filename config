/**
 * 他部門稼働 申請・承認・成果報告（職務権限 No.43）【設定】
 * ふだん変えるのはこのファイルだけ。保存した時点で、次の申請や操作から反映される
 * （プルダウンの選択肢・通知の時刻・保護を変えたときだけ、setup を実行し直す）
 *
 * 今の運用
 *   ・申請者は営業本部。申請者の本部は、フォームで取得したメールアドレスでマスタから決める
 *     （マスタにいない、または本部名が空の申請は自動で却下）
 *   ・Chatworkのグループには承認者だけが入るので、申請者には通知しない
 *   ・10営業日以下は営業本部の承認者が承認。11〜20営業日はマーケティング本部の承認者（2名）の二次承認も必要。
 *     21営業日以上は自動で却下
 *   ・相手方（稼働先）は、二次承認者と同じマーケティング本部の2名
 *   ・承認されたら、承認者と相手方に通知し、承認者用の成果報告フォームを付ける
 *   ・成果報告は承認者が行う。提出期限は稼働終了日の30日後。期限を過ぎても未提出なら承認者に通知する
 */

// ===== 基本の設定 =====
const CONFIG = {
  // 本部の承認者だけで完了する稼働期間の上限（営業日。土日祝を除いて数える）。0 なら上限なし
  MAX_BUSINESS_DAYS: 10,
  // 二次承認まで受ければ認める上限（営業日）。これを超える申請は自動で却下。二次承認を使わないなら 0
  EXEC_MAX_BUSINESS_DAYS: 20,
  // 二次承認をする本部（マスタでこの本部名・区分「承認者」の人が二次承認する。相手方への通知もこの人たち）
  EXEC_HONBU: 'マーケティング本部',
  // 祝日を営業日から除くか、どのカレンダーの祝日か
  SKIP_HOLIDAYS: true,
  HOLIDAY_CALENDAR_ID: 'ja.japanese#holiday@group.v.calendar.google.com',

  // 成果報告の提出期限（稼働終了日の何日後か）。期限の日を迎えても未提出なら、平日の朝に承認者へ通知する
  REMIND_AFTER_DAYS: 30,
  REMIND_HOUR: 9,

  // true：承認できるのは申請者の本部の承認者、二次承認は EXEC_HONBU の承認者だけ（本番は true）
  ONLY_MASTER_APPROVER: true,
  // 管理者（承認後の変更・代理の成果報告ができる人）のメールアドレス。いなければ []
  ADMIN_EMAILS: ['wataru-sato@solu.co.jp'],
  // false にするとシートを保護しない（テスト用環境だけ。本番は true）
  PROTECT_SHEETS: true,

  // シートの名前と、その他
  SHEET_APPLY: '申請回答',
  SHEET_RESULT: '成果回答',
  SHEET_ERROR: '通知エラー',     // Chatworkに送れなかった通知を記録するシート
  PREPARED_ROWS: 2000,           // 承認列のプルダウンと保護を用意しておく行数
  TIMEZONE: 'Asia/Tokyo',
};


// ===== フォームの設問名（シートの1行目と1文字も違わないように） =====
// 申請フォーム（＝申請回答シートの見出し）
const F = {
  TIMESTAMP: 'タイムスタンプ',
  EMAIL: 'メールアドレス',           // この値でマスタを引き、申請者名と本部を決める
  MEMBER: '稼働予定メンバー',        // 必須
  TARGET_HONBU: '申請先',            // 任意：稼働メンバーのいる課など。記録と通知の表示だけに使う
  START: '稼働開始予定日',           // 必須：「日付」の設問
  END: '稼働終了予定日',             // 必須：「日付」の設問
  PURPOSE: '目的・期待する成果',     // 任意
};
// 成果報告フォーム（＝成果回答シートの見出し）
const R = {
  EMAIL: 'メールアドレス',
  ID: '管理ID',                      // 必須：記述式。承認の通知のリンクから開くと入力済みになる
  ACTUAL: '実績日数',                // 必須：入力のまま転記する
  RESULT: '成果内容',                // 必須
  BIKOU: '成果備考',                 // 任意
};
const REQUIRED_F = ['MEMBER', 'START', 'END'];
const REQUIRED_R = ['ID', 'ACTUAL', 'RESULT'];


// ===== マスタ（申請者・承認者の一覧のシート） =====
// 申請者は「区分：申請者」で、本部名（営業本部）も入れる。この本部名で承認者が決まる（空だと申請は却下される）
// 二次承認者は、本部名を CONFIG.EXEC_HONBU（マーケティング本部）、区分を「承認者」にして登録する
// ChatworkのIDが必要なのは承認者だけ
const MASTER = {
  SHEET: '使用中リスト',
  ROLE: '区分',                  // 「申請者」か「承認者」
  HONBU: '本部名',
  NAME: '名前',
  MAIL: 'mail',
  CW_ID: 'chatwork_account_ID',  // 数字。空ならメンションしない
  APPLICANT: '申請者',
  APPROVER: '承認者',
};


// ===== 通知のオン・オフ =====
const NOTIFY = {
  '承認依頼': true,
  '二次承認依頼': true,
  '承認': true,
  '却下': true,
  '修正': true,
  '成果報告': true,
  '督促': true,
};

// ===== 通知ごとのメンション先 =====
// 使える言葉：'承認者'（申請者の本部の承認者）／'二次承認者'（EXEC_HONBU の承認者。相手方も同じ人）／
//             '稼働先承認者'（申請先の本部の承認者。今の運用では使わない）／'申請者'（今の運用では使わない。グループにいないため）
const MENTIONS = {
  '承認依頼': ['承認者'],
  '二次承認依頼': ['二次承認者'],
  '承認': ['承認者', '二次承認者'],
  '却下': ['承認者'],
  '修正': ['承認者'],
  '成果報告': ['二次承認者'],
  '督促': ['承認者'],
};


// ===== 通知の文面 =====
//   ・{ } の部分に申請の内容が入る（半角の { }）。先頭のメンションと、枠・見出しは自動で付く
//   ・名前の差し込みの後ろには「さん」を1つ書く（複数人なら「佐藤さん・鈴木さん」になる）
//   ・キー（'承認依頼' '督促' など）は内部の名前なので変えない。表示はタイトルと本文で変える
//   使える差し込み：
//     {管理ID} {申請者名} {申請者メール} {申請本部} {承認者名} {稼働メンバー} {稼働先本部}
//     {開始日} {終了日} {提出期限} {営業日数} {承認の段階} {目的} {概要} {承認した人} {一次承認者} {二次承認者名}
//     {理由} {却下理由} {実績日数} {成果内容} {成果備考} {成果報告URL}
//     {シートのリンク}（承認依頼・二次承認依頼）　{件数}（督促）　{再提出}（成果報告）
//     {注意書き}（承認依頼・二次承認依頼・成果報告。気になる点があるときだけ入る）
const MESSAGES = {
  '概要': `申請者：{申請者名}（{申請本部}）
稼働メンバー：{稼働メンバー}（{稼働先本部}）
期間：{開始日}〜{終了日}（{営業日数}営業日）`,

  '承認依頼': {
    'タイトル': '【承認依頼】他部門稼働 {管理ID}',
    '本文': `{承認者名}さん、{申請者名}さんから承認依頼です。{注意書き}

{概要}
目的：{目的}

▼シートの「承認ステータス」で「承認」「却下」「修正」のどれかを選んでください（却下のときは先に「理由（却下・修正）」を記入）
{シートのリンク}`,
  },

  '二次承認依頼': {
    'タイトル': '【二次承認依頼】他部門稼働 {管理ID}',
    '本文': `{二次承認者名}さん、稼働期間が{営業日数}営業日の申請のため、二次承認をお願いします。{注意書き}
一次承認：{一次承認者}さん（承認済み）

{概要}
目的：{目的}

▼シートの「承認ステータス」で「承認」「却下」「修正」のどれかを選んでください（却下のときは先に「理由（却下・修正）」を記入）
{シートのリンク}`,
  },

  '承認': {
    'タイトル': '【承認】他部門稼働 {管理ID}',
    '本文': `{稼働メンバー}さんの稼働が承認されました。

{概要}
承認した人：{承認した人}

▼稼働が終わったら、{承認者名}さんがこのフォームから成果を報告してください（承認者用・管理IDは入力済み）
提出期限：{提出期限}（稼働終了日の30日後）
{成果報告URL}`,
  },

  '却下': {
    'タイトル': '【却下】他部門稼働 {管理ID}',
    '本文': `{申請者名}さんの申請は却下されました。申請者へのご連絡をお願いします。

{概要}
却下理由：{却下理由}
対応した人：{承認した人}`,
  },

  '修正': {
    'タイトル': '【修正依頼】他部門稼働 {管理ID}',
    '本文': `{申請者名}さんの申請に、修正依頼が出ました。申請者に、内容を直して申請し直すようお伝えください（この申請はここで終わりです）。
直してほしい点：{理由}

{概要}`,
  },

  // {再提出} は2回目以降の報告のときだけ「（再提出）」になる
  '成果報告': {
    'タイトル': '【成果報告{再提出}】他部門稼働 {管理ID}',
    '本文': `{二次承認者名}さん、{稼働メンバー}さんの稼働成果の報告です。{注意書き}

{概要}
実績日数：{実績日数}
成果：{成果内容}
成果備考：{成果備考}`,
  },

  // 提出期限を迎えても成果報告がない申請の通知。「行」は1件ごとに繰り返される
  '督促': {
    'タイトル': '【成果報告 提出期限】未提出の他部門稼働（{件数}件）',
    '前置き': '次の申請は、成果報告の提出期限（稼働終了日の30日後）を迎えました。承認者用の成果報告フォームから提出をお願いします。',
    '行': `・{管理ID}　{申請者名}さんの申請：{稼働メンバー}（{稼働先本部}）
　稼働終了 {終了日}　提出期限 {提出期限}
　{成果報告URL}`,
  },
};
