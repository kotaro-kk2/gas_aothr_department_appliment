// ===== 申請回答シートの右側に足す管理列（この順で追加する） =====
const M = {
  ID: '管理ID',
  APPLICANT_NAME: '申請者名（自動）',
  STATUS: '承認ステータス',
  REASON: '却下理由',
  APPROVER: '承認者',
  APPROVED_AT: '承認日時',
  RESULT_STATUS: '成果入力ステータス',
  ACTUAL: '実績時間',
  RESULT: '成果内容',
  REPORTED_AT: '成果報告日時',
};
const M_ORDER = [M.ID, M.APPLICANT_NAME, M.STATUS, M.REASON, M.APPROVER, M.APPROVED_AT,
  M.RESULT_STATUS, M.ACTUAL, M.RESULT, M.REPORTED_AT];

const S = { PENDING: '申請中', APPROVED: '承認', REJECTED: '却下', NOT_REQUIRED: '承認不要' };
const RS = { NONE: '未入力', DONE: '入力完了' };
const ID_MARK = 'ZZIDZZ';


// ===== トリガー：フォーム送信時 =====
function handleFormSubmit(e) {
  if (!e || !e.range) throw new Error('この関数はフォーム送信で自動的に動きます。エディタから実行せず、フォームから送信して試してください。');
  const sheet = e.range.getSheet();
  const name = sheet.getName();
  if (name !== CONFIG.SHEET_APPLY && name !== CONFIG.SHEET_RESULT) return;
  // 送信トリガーが二重に動くことがあるため、同じ行は一度だけ処理する
  if (!firstTime_('submit:' + name + ':' + e.range.getRow())) return;
  checkConfig_();
  if (name === CONFIG.SHEET_APPLY) onApplication_(sheet, e.range.getRow());
  else onResult_(sheet, e.range.getRow());
}

// 申請の受付：管理ID・申請者名・初期ステータスを入れ、承認依頼を送る
function onApplication_(sheet, row) {
  const cols = columns_(sheet);
  requireCols_(cols, usedF_().concat(M_ORDER), 'フォームの設問名（F）を確認するか、setup を実行してください。');
  const rec = withLock_(() => {
    const r = readRow_(sheet, cols, row);
    if (r[M.ID]) return null; // 採番済み
    const status = initialStatus_(r[F.HOURS]);
    const id = nextId_();
    const p = personByMail_(r[F.EMAIL], MASTER.APPLICANT);
    writeRow_(sheet, cols, row, {
      [M.ID]: id,
      [M.APPLICANT_NAME]: p ? p.name : '（マスタ未登録）',
      [M.STATUS]: status,
      [M.RESULT_STATUS]: RS.NONE,
    });
    setStatus_(id, status);
    return readRow_(sheet, cols, row);
  });
  if (!rec) return;
  postChatwork_(rec[M.STATUS] === S.PENDING
    ? message_('承認依頼', rec, { 'シートのリンク': rowLink_(sheet, row, cols[M.STATUS]), '注意書き': applicationNotes_(rec) })
    : message_('承認不要', rec, { '注意書き': applicationNotes_(rec) }));
}

// 成果報告の受付：申請回答シートに転記し、共有する
function onResult_(resultSheet, row) {
  const rcols = columns_(resultSheet);
  requireCols_(rcols, usedR_(), 'フォームの設問名（R）を確認してください。');
  const r = readRow_(resultSheet, rcols, row);
  const id = String(r[R.ID] || '').trim();
  const apply = applySheet_();
  const cols = columns_(apply);

  const out = withLock_(() => {
    const target = findRowById_(apply, cols, id);
    if (!target) return null;
    const again = readRow_(apply, cols, target)[M.RESULT_STATUS] === RS.DONE;
    writeRow_(apply, cols, target, {
      [M.ACTUAL]: Number(r[R.ACTUAL]),
      [M.RESULT]: String(r[R.RESULT] || '').trim(),
      [M.REPORTED_AT]: new Date(),
      [M.RESULT_STATUS]: RS.DONE,
    });
    return { rec: readRow_(apply, cols, target), again: again };
  });

  if (!out) {
    postChatwork_(`[info][title]【要確認】成果報告の管理IDが見つかりません[/title]` +
      `管理ID：${id || '（空欄）'}\n報告者：${r[R.EMAIL] || '不明'}\n` +
      `「${CONFIG.SHEET_RESULT}」シートの内容を確認してください。[/info]`);
    return;
  }
  const st = out.rec[M.STATUS];
  const note = (st === S.APPROVED || st === S.NOT_REQUIRED) ? '' : `\n※承認ステータスが「${st}」の申請への報告です。`;
  postChatwork_(message_('成果報告', out.rec, { '再提出': out.again ? '（再提出）' : '', '注意書き': note }));
}


// ===== トリガー：編集時（承認・却下） =====
function handleEdit(e) {
  if (!e || !e.range) throw new Error('この関数はシートの編集で自動的に動きます。エディタから実行せず、承認ステータスを選んで試してください。');
  const range = e.range;
  const sheet = range.getSheet();
  if (sheet.getName() !== CONFIG.SHEET_APPLY) return;
  const cols = columns_(sheet);
  const sc = cols[M.STATUS];
  if (!sc || sc < range.getColumn() || sc > range.getLastColumn()) return;
  const firstRow = Math.max(2, range.getRow());
  const lastRow = range.getLastRow();
  if (lastRow < firstRow) return;

  const editor = String((e.user && e.user.getEmail && e.user.getEmail()) || '').trim();
  const bulk = range.getNumRows() > 1 || range.getNumColumns() > 1;

  const message = withLock_(() => bulk
    ? bulkEdit_(sheet, cols, firstRow, lastRow, editor)
    : statusEdit_(sheet, cols, firstRow, editor));
  if (message) postChatwork_(message);
}

// 1セルの変更：承認・却下を記録するか、無効なら元に戻す
function statusEdit_(sheet, cols, row, editor) {
  const rec = readRow_(sheet, cols, row);
  const id = rec[M.ID];
  const value = String(rec[M.STATUS] || '').trim();
  const cell = sheet.getRange(row, cols[M.STATUS]);
  if (!id) { if (value) cell.setValue(''); return null; }
  const truth = currentStatus_(id, rec);
  if (value === truth) return null;
  const link = rowLink_(sheet, row, cols[M.STATUS]);

  // 管理者（スクリプトの所有者）は、テストや修正のためにどの値にも変えられる
  if (isAdmin_(editor)) {
    setStatus_(id, value);
    if (value === S.APPROVED || value === S.REJECTED) return decide_(sheet, cols, rec, value, editor);
    writeRow_(sheet, cols, row, { [M.APPROVER]: '', [M.APPROVED_AT]: '' });
    return `[info][title]【修正】${id} のステータスを管理者が「${value || '空欄'}」にしました[/title]${link}[/info]`;
  }

  let error = '';
  if (!editor) error = '操作した人のアカウントを確認できませんでした。';
  else if (truth !== S.PENDING) error = `この申請はすでに「${truth}」です。`;
  else if (value !== S.APPROVED && value !== S.REJECTED) error = `「${value || '空欄'}」には変更できません。「承認」か「却下」を選んでください。`;
  else if (editor.toLowerCase() === String(rec[F.EMAIL]).toLowerCase()) error = '申請者本人は承認・却下できません。';
  else if (CONFIG.ONLY_MASTER_APPROVER && !isApproverFor_(editor, rec)) {
    error = `承認・却下できるのは、${honbuName_(rec[F.APPLY_HONBU])}の承認者（マスタに登録された人）だけです。`;
  }

  if (error) {
    cell.setValue(truth);
    return `[info][title]【取り消し】${id} の承認ステータスの変更を元に戻しました[/title]` +
      `操作した人：${nameByMail_(editor) || '不明'}\n選ばれた値：${value || '空欄'}\n理由：${error}\n${link}[/info]`;
  }
  setStatus_(id, value);
  return decide_(sheet, cols, rec, value, editor);
}

// 複数セルをまとめて変えた場合：管理者も含めて全部元に戻す
// （承認者・日時の記録と通知は、1件ずつの変更でしか正しく行えないため）
function bulkEdit_(sheet, cols, firstRow, lastRow, editor) {
  const changed = [];
  for (let row = firstRow; row <= lastRow; row++) {
    const rec = readRow_(sheet, cols, row);
    const id = rec[M.ID];
    const value = String(rec[M.STATUS] || '').trim();
    const cell = sheet.getRange(row, cols[M.STATUS]);
    if (!id) { if (value) cell.setValue(''); continue; }
    const truth = currentStatus_(id, rec);
    if (value === truth) continue;
    cell.setValue(truth);
    changed.push(id);
  }
  if (!changed.length) return null;
  return `[info][title]【取り消し】複数のセルをまとめて変更したため、元に戻しました[/title]` +
    `操作した人：${nameByMail_(editor) || '不明'}\n対象：${changed.join('、')}\n` +
    `承認・却下は、1件ずつプルダウンで選んでください。[/info]`;
}

function decide_(sheet, cols, rec, value, editor) {
  const now = new Date();
  writeRow_(sheet, cols, rec._row, { [M.APPROVER]: editor, [M.APPROVED_AT]: now });
  rec[M.STATUS] = value;
  rec[M.APPROVER] = editor;
  rec[M.APPROVED_AT] = now;
  return message_(value === S.APPROVED ? '承認' : '却下', rec);
}

// 申請時の承認ステータスを決める。判定できないときは、必ず承認が必要な「申請中」にする
//   1. 予定時間が空・数字でない・0以下なら「申請中」
//   2. NO_APPROVAL_MAX_HOURS が0（または正の数でない）なら「申請中」
//   3. 設定が正の数のときだけ、予定時間がそれ以下なら「承認不要」
function initialStatus_(hoursValue) {
  const text = String(hoursValue === null || hoursValue === undefined ? '' : hoursValue).trim();
  const hours = Number(text);
  if (text === '' || !isFinite(hours) || hours <= 0) return S.PENDING;
  const limit = Number(CONFIG.NO_APPROVAL_MAX_HOURS);
  if (!(limit > 0)) return S.PENDING;
  return hours <= limit ? S.NOT_REQUIRED : S.PENDING;
}


// ===== トリガー：時間主導（督促） =====
// 成果報告が遅れているもの（稼働終了日から REMIND_AFTER_DAYS 日たっても未入力）だけを督促
function dailyReminder() {
  checkConfig_();
  const today = startOfDay_(new Date());
  if (today.getDay() === 0 || today.getDay() === 6) return;
  const sheet = applySheet_();
  const cols = columns_(sheet);
  const last = sheet.getLastRow();
  if (last < 2) return;

  const late = [];
  for (let row = 2; row <= last; row++) {
    const rec = readRow_(sheet, cols, row);
    if (!rec[M.ID]) continue;
    const st = rec[M.STATUS];
    if ((st === S.APPROVED || st === S.NOT_REQUIRED) && rec[M.RESULT_STATUS] !== RS.DONE && rec[F.END] instanceof Date) {
      if (today >= addDays_(startOfDay_(rec[F.END]), CONFIG.REMIND_AFTER_DAYS)) late.push(rec);
    }
  }
  if (!late.length) return;

  const t = MESSAGES['督促'];
  const extra = { '件数': late.length };
  let people = [];
  late.forEach(rec => { people = people.concat(recipients_(rec, MENTIONS['督促'] || [])); });
  postChatwork_(mentionText_(people) +
    `[info][title]${fill_(t['タイトル'], {}, extra)}[/title]${fill_(t['前置き'], {}, extra)}\n\n` +
    late.map(rec => fill_(t['行'], rec)).join('\n') + '[/info]');
}


// ===== 通知の組み立て（文面そのものは上の MESSAGES で変える） =====
// 通知の種類ごとに、メンション（MENTIONS）と文面（MESSAGES）を組み合わせる
function message_(kind, rec, extra) {
  return mentionText_(recipients_(rec, MENTIONS[kind] || [])) + compose_(kind, rec, extra);
}

// MESSAGES の「タイトル」と「本文」に差し込みをして、枠付きの1通にする
function compose_(kind, rec, extra) {
  const t = MESSAGES[kind];
  return `[info][title]${fill_(t['タイトル'], rec, extra)}[/title]${fill_(t['本文'], rec, extra)}[/info]`;
}

// 文面の {名前} を、申請の内容に置き換える。一覧にない名前は {…} のまま残す（打ち間違いに気づけるように）
function fill_(template, rec, extra) {
  const v = {
    '管理ID': () => rec[M.ID],
    '申請者名': () => applicantName_(rec),
    '申請者メール': () => rec[F.EMAIL],
    '申請本部': () => honbuName_(rec[F.APPLY_HONBU]),
    '承認者名': () => names_(approversOf_(rec[F.APPLY_HONBU])) || '（承認者未登録）',
    '稼働メンバー': () => rec[F.MEMBER],
    '稼働先本部': () => hasF_('TARGET_HONBU') ? honbuName_(rec[F.TARGET_HONBU]) : '',
    '稼働先承認者名': () => hasF_('TARGET_HONBU') ? names_(approversOf_(rec[F.TARGET_HONBU])) : '',
    '開始日': () => fmt_(rec[F.START], 'yyyy/MM/dd'),
    '終了日': () => fmt_(rec[F.END], 'yyyy/MM/dd'),
    '予定時間': () => rec[F.HOURS],
    '目的': () => hasF_('PURPOSE') ? rec[F.PURPOSE] : '',
    '承認した人': () => nameByMail_(rec[M.APPROVER]),
    '却下理由': () => String(rec[M.REASON] || '').trim() || '（未記入。シートの「却下理由」を確認してください）',
    '実績時間': () => rec[M.ACTUAL],
    '成果内容': () => rec[M.RESULT],
    '成果報告URL': () => resultUrl_(rec[M.ID]),
    '概要': () => fill_(MESSAGES['概要'], rec),
    '注意書き': () => '',
    '再提出': () => '',
    'シートのリンク': () => '',
    '件数': () => '',
  };
  Object.keys(extra || {}).forEach(k => { v[k] = () => extra[k]; });
  return String(template).replace(/\{([^{}\n]+)\}/g, (all, key) => {
    if (!v[key]) return all;
    const x = v[key]();
    return x === undefined || x === null ? '' : String(x);
  });
}

// MENTIONS の言葉（申請者／承認者／稼働先承認者）を、マスタの人に置き換える
function recipients_(rec, roles) {
  let people = [];
  roles.forEach(role => {
    if (role === '申請者') {
      const p = personByMail_(rec[F.EMAIL], MASTER.APPLICANT);
      if (p) people.push(p);
    } else if (role === '承認者') {
      people = people.concat(approversOf_(rec[F.APPLY_HONBU]));
    } else if (role === '稼働先承認者') {
      if (hasF_('TARGET_HONBU')) people = people.concat(approversOf_(rec[F.TARGET_HONBU]));
    } else {
      console.warn(`MENTIONS に使えない言葉「${role}」があります（申請者／承認者／稼働先承認者のどれか）。`);
    }
  });
  return people;
}

// 人の一覧から「[To:ID]名前さん」を作る（同じ人は1回だけ。IDが空なら付けない）
function mentionText_(people) {
  const seen = {};
  const lines = [];
  people.forEach(p => {
    const id = String(p.cw || '').trim();
    if (!/^\d+$/.test(id) || seen[id]) return;
    seen[id] = true;
    lines.push(`[To:${id}]${p.name}さん`);
  });
  return lines.length ? lines.join('\n') + '\n' : '';
}

// 申請時の注意書き（マスタとの食い違いがあるときだけ）
function applicationNotes_(rec) {
  const notes = [];
  const p = personByMail_(rec[F.EMAIL], MASTER.APPLICANT);
  const honbu = honbuName_(rec[F.APPLY_HONBU]);
  if (!p) notes.push(`※申請者のメールアドレス（${rec[F.EMAIL] || '空欄'}）がマスタにありません。`);
  else if (p.honbu && honbu && p.honbu !== honbu) notes.push(`※マスタの本部（${p.honbu}）と、選ばれた本部（${honbu}）が違います。`);
  if (!approversOf_(rec[F.APPLY_HONBU]).length) notes.push(`※「${honbu || '空欄'}」の承認者がマスタに登録されていません。`);
  return notes.length ? '\n' + notes.join('\n') : '';
}


// ===== マスタの読み取り =====
let MASTER_CACHE_ = null;

// マスタの全行を読む（1回の実行につき1回だけ読む）
function master_() {
  if (MASTER_CACHE_) return MASTER_CACHE_;
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(MASTER.SHEET);
  if (!sh) throw new Error(`シート「${MASTER.SHEET}」がありません。setup を実行してください。`);
  const cols = columns_(sh);
  requireCols_(cols, [MASTER.ROLE, MASTER.HONBU, MASTER.NAME, MASTER.MAIL, MASTER.CW_ID], 'マスタの1行目の見出しを確認してください。');
  const list = [];
  for (let row = 2; row <= sh.getLastRow(); row++) {
    const r = readRow_(sh, cols, row);
    const mail = String(r[MASTER.MAIL] || '').trim().toLowerCase();
    const name = String(r[MASTER.NAME] || '').trim();
    if (!mail && !name) continue;
    list.push({
      role: String(r[MASTER.ROLE] || '').trim(),
      honbu: String(r[MASTER.HONBU] || '').trim(),
      name: name,
      mail: mail,
      cw: String(r[MASTER.CW_ID] === null || r[MASTER.CW_ID] === undefined ? '' : r[MASTER.CW_ID]).trim(),
    });
  }
  MASTER_CACHE_ = list;
  return list;
}

// メールアドレスからマスタの人を探す（同じ人が複数行あれば、preferRole の区分を優先）
function personByMail_(mail, preferRole) {
  const m = String(mail || '').trim().toLowerCase();
  if (!m) return null;
  const hits = master_().filter(p => p.mail === m);
  return hits.filter(p => p.role === preferRole)[0] || hits[0] || null;
}

// 本部の承認者（区分が「承認者」の人）を全員返す
function approversOf_(honbuValue) {
  const h = honbuName_(honbuValue);
  if (!h) return [];
  return master_().filter(p => p.role === MASTER.APPROVER && p.honbu === h);
}

function isApproverFor_(mail, rec) {
  const m = String(mail || '').trim().toLowerCase();
  return approversOf_(rec[F.APPLY_HONBU]).some(p => p.mail === m);
}

function applicantName_(rec) {
  const p = personByMail_(rec[F.EMAIL], MASTER.APPLICANT);
  return p ? p.name : `（マスタ未登録）${rec[F.EMAIL] || ''}`;
}

function nameByMail_(mail) {
  if (!mail) return '';
  const p = personByMail_(mail, MASTER.APPROVER);
  return p ? p.name : String(mail);
}

function names_(people) {
  return people.map(p => p.name).join('・');
}

// 本部の選択肢の値から本部名を取り出す（「営業本部（佐藤）」のように括弧が付いていても「営業本部」にする）
function honbuName_(value) {
  const s = String(value || '').trim();
  const m = s.match(/^(.+?)\s*[（(].*[）)]$/);
  return m ? m[1] : s;
}


// ===== Chatworkへの送信 =====
function chatworkEnabled_() {
  const p = PropertiesService.getScriptProperties();
  return !!(p.getProperty('CHATWORK_TOKEN') && p.getProperty('CHATWORK_ROOM_ID'));
}

function postChatwork_(body) {
  body = mentionHeader_() + body;
  if (!chatworkEnabled_()) {
    console.log('[Chatwork未設定のため、投稿内容をログに出力]\n' + body);
    return;
  }
  const p = PropertiesService.getScriptProperties();
  const res = UrlFetchApp.fetch(`https://api.chatwork.com/v2/rooms/${p.getProperty('CHATWORK_ROOM_ID')}/messages`, {
    method: 'post',
    headers: { 'X-ChatWorkToken': p.getProperty('CHATWORK_TOKEN') },
    payload: { body: body },
    muteHttpExceptions: true,
  });
  const code = res.getResponseCode();
  if (code < 200 || code >= 300) throw new Error(`Chatworkへの投稿に失敗しました（${code}）：${res.getContentText()}`);
}

// スクリプト プロパティ CHATWORK_TO（アカウントID。複数はカンマ区切り）があれば、先頭に [To:ID] を付ける（テスト用）
function mentionHeader_() {
  const raw = String(PropertiesService.getScriptProperties().getProperty('CHATWORK_TO') || '');
  const ids = raw.split(/[,、\s]+/).filter(Boolean);
  const bad = ids.filter(id => !/^\d+$/.test(id));
  if (bad.length) console.warn(`CHATWORK_TO に数字以外が含まれています（${bad.join('、')}）。アカウントIDは数字だけです。`);
  const good = ids.filter(id => /^\d+$/.test(id));
  return good.length ? good.map(id => `[To:${id}]`).join('') + '\n' : '';
}


// ===== 初期設定（手動で実行。何度実行してもよい） =====
function setup() {
  checkConfig_();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const masterReport = setupMaster_(ss);

  const apply = ss.getSheetByName(CONFIG.SHEET_APPLY);
  const result = ss.getSheetByName(CONFIG.SHEET_RESULT);
  if (!apply || !result) {
    throw new Error(`シート「${CONFIG.SHEET_APPLY}」と「${CONFIG.SHEET_RESULT}」が必要です。フォームの回答先をこのスプレッドシートにし、回答シートの名前を変更してください。`);
  }
  requireCols_(columns_(apply), usedF_(), 'F に入力した設問名が、申請回答シートの1行目と一致しているか確認してください。');
  requireCols_(columns_(result), usedR_(), 'R に入力した設問名が、成果回答シートの1行目と一致しているか確認してください。');
  const clash = usedF_().filter(h => M_ORDER.indexOf(h) >= 0);
  if (clash.length) throw new Error(`フォームの設問名と管理列の名前が同じです（${clash.join('、')}）。M の名前か、設問名を変えてください。`);

  // 管理列を右端に追加
  M_ORDER.forEach(h => {
    if (columns_(apply)[h]) return;
    const c = apply.getLastColumn() + 1;
    if (c > apply.getMaxColumns()) apply.insertColumnsAfter(apply.getMaxColumns(), c - apply.getMaxColumns());
    apply.getRange(1, c).setValue(h);
  });
  const cols = columns_(apply);
  if (apply.getMaxRows() < CONFIG.PREPARED_ROWS) {
    apply.insertRowsAfter(apply.getMaxRows(), CONFIG.PREPARED_ROWS - apply.getMaxRows());
  }
  const n = apply.getMaxRows() - 1;
  apply.getRange(1, 1, 1, apply.getLastColumn()).setFontWeight('bold');
  apply.setFrozenRows(1);
  apply.getRange(2, cols[M.STATUS], n, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireValueInList([S.PENDING, S.APPROVED, S.REJECTED, S.NOT_REQUIRED], true)
      .setAllowInvalid(false).build());
  [M.APPROVED_AT, M.REPORTED_AT].forEach(h => apply.getRange(2, cols[h], n, 1).setNumberFormat('yyyy/mm/dd hh:mm'));

  // setup より前に届いていた申請に管理IDを振る（通知はしない）
  const filled = backfill_(apply, cols);

  // 保護：申請回答は「承認ステータス」「却下理由」だけ編集可、成果回答は編集不可
  [apply, result].forEach(sh => sh.getProtections(SpreadsheetApp.ProtectionType.SHEET).forEach(p => p.remove()));
  const pa = apply.protect().setDescription('他部門稼働：承認ステータスと却下理由以外は編集不可');
  pa.setUnprotectedRanges([apply.getRange(2, cols[M.STATUS], n, 1), apply.getRange(2, cols[M.REASON], n, 1)]);
  ownerOnly_(pa);
  ownerOnly_(result.protect().setDescription('他部門稼働：成果報告フォームの回答（編集不可）'));

  // 成果報告フォームの「管理ID入力済みURL」
  PropertiesService.getScriptProperties().setProperty('RESULT_FORM_URL', buildPrefilledUrl_(result));

  // トリガー（重複しないよう作り直す）
  const handlers = ['handleFormSubmit', 'handleEdit', 'dailyReminder'];
  ScriptApp.getProjectTriggers().forEach(t => { if (handlers.indexOf(t.getHandlerFunction()) >= 0) ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('handleFormSubmit').forSpreadsheet(ss).onFormSubmit().create();
  ScriptApp.newTrigger('handleEdit').forSpreadsheet(ss).onEdit().create();
  ScriptApp.newTrigger('dailyReminder').timeBased().everyDays(1).atHour(CONFIG.REMIND_HOUR).create();

  console.log(masterReport + `\n初期設定が完了しました。既存の申請 ${filled} 件に管理IDを振りました。` +
    `Chatwork通知：${chatworkEnabled_() ? 'あり' : 'なし（投稿内容は実行ログに出ます）'}`);
}

// マスタの準備と点検。なければ見出し付きで作って止まる。あれば保護して中身を点検する
function setupMaster_(ss) {
  let sh = ss.getSheetByName(MASTER.SHEET);
  if (!sh) {
    sh = ss.insertSheet(MASTER.SHEET);
    sh.getRange(1, 1, 1, 5).setValues([[MASTER.ROLE, MASTER.HONBU, MASTER.NAME, MASTER.MAIL, MASTER.CW_ID]]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange(2, 1, sh.getMaxRows() - 1, 1).setDataValidation(
      SpreadsheetApp.newDataValidation().requireValueInList([MASTER.APPLICANT, MASTER.APPROVER], true).build());
    sh.getRange(2, 5, sh.getMaxRows() - 1, 1).setNumberFormat('@');
    throw new Error(`シート「${MASTER.SHEET}」を作りました。申請者と承認者を入力してから、もう一度 setup を実行してください。`);
  }
  MASTER_CACHE_ = null;
  const list = master_();
  sh.getProtections(SpreadsheetApp.ProtectionType.SHEET).forEach(p => p.remove());
  ownerOnly_(sh.protect().setDescription('他部門稼働：マスタ（管理者のみ編集）'));

  const lines = [`マスタ：${list.length}人`];
  const badRole = list.filter(p => p.role !== MASTER.APPLICANT && p.role !== MASTER.APPROVER);
  if (badRole.length) lines.push(`注意：区分が「${MASTER.APPLICANT}」「${MASTER.APPROVER}」以外の行があります（${badRole.map(p => p.name).join('、')}）`);
  const approvers = list.filter(p => p.role === MASTER.APPROVER);
  const honbus = approvers.map(p => p.honbu).filter((h, i, a) => h && a.indexOf(h) === i);
  lines.push(`承認者がいる本部：${honbus.join('、') || 'なし'}（申請フォームの本部の選択肢と同じ文字にしてください）`);
  const noId = list.filter(p => !/^\d+$/.test(p.cw));
  if (noId.length) lines.push(`注意：chatwork_account_ID が未入力の人（メンションなしで通知）：${noId.map(p => p.name).join('、')}`);
  const noMail = list.filter(p => !p.mail);
  if (noMail.length) lines.push(`注意：mail が未入力の人（申請者名の補完や承認の確認ができません）：${noMail.map(p => p.name).join('、')}`);
  return lines.join('\n');
}

function backfill_(sheet, cols) {
  let count = 0;
  withLock_(() => {
    for (let row = 2; row <= sheet.getLastRow(); row++) {
      const rec = readRow_(sheet, cols, row);
      if (rec[M.ID] || !rec[F.TIMESTAMP]) continue;
      const status = initialStatus_(rec[F.HOURS]);
      const id = nextId_();
      const p = personByMail_(rec[F.EMAIL], MASTER.APPLICANT);
      writeRow_(sheet, cols, row, {
        [M.ID]: id, [M.APPLICANT_NAME]: p ? p.name : '（マスタ未登録）',
        [M.STATUS]: status, [M.RESULT_STATUS]: RS.NONE,
      });
      setStatus_(id, status);
      count++;
    }
  });
  return count;
}

function ownerOnly_(protection) {
  protection.addEditor(Session.getEffectiveUser());
  protection.removeEditors(protection.getEditors());
  if (protection.canDomainEdit()) protection.setDomainEdit(false);
}

function buildPrefilledUrl_(resultSheet) {
  const url = resultSheet.getFormUrl();
  if (!url) throw new Error(`シート「${resultSheet.getName()}」に成果報告フォームが連携されていません。`);
  const form = FormApp.openByUrl(url);
  const item = form.getItems(FormApp.ItemType.TEXT).filter(i => i.getTitle() === R.ID)[0];
  if (!item) throw new Error(`成果報告フォームに記述式の設問「${R.ID}」がありません。`);
  return form.createResponse().withItemResponse(item.asTextItem().createResponse(ID_MARK)).toPrefilledUrl();
}

// F と R の必須項目が入力されているか確かめる
function checkConfig_() {
  const missing = REQUIRED_F.filter(k => !hasF_(k)).map(k => 'F.' + k)
    .concat(REQUIRED_R.filter(k => !String(R[k] || '').trim()).map(k => 'R.' + k));
  if (missing.length) {
    throw new Error(`フォームの設問名が未入力です：${missing.join('、')}。コード上部の F と R に、実際の設問名を入力してください。`);
  }
}

function hasF_(key) { return !!String(F[key] || '').trim(); }
function usedF_() { return Object.keys(F).filter(hasF_).map(k => F[k]); }
function usedR_() { return Object.keys(R).filter(k => String(R[k] || '').trim()).map(k => R[k]); }


