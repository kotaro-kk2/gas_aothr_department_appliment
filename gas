//   ・名前の差し込みには「さん」が付かないので、文面側で付ける。承認者が複数なら「佐藤・鈴木」のように並ぶ
//   使える差し込み：
//     {管理ID} {申請者名} {申請者メール} {申請本部} {承認者名}
//     {稼働メンバー} {稼働先本部} {稼働先承認者名}
//     {開始日} {終了日} {予定時間} {目的} {概要}
//     {承認した人} {却下理由} {実績時間} {成果内容} {成果報告URL}
//     {シートのリンク}（承認依頼だけ）　{件数}（督促のタイトルと前置きだけ）
//     {再提出}（成果報告だけ）　{注意書き}（承認依頼・承認不要・成果報告。問題があるときだけ注意の行が入る）
const MESSAGES = {
  // すべての通知に入る共通の数行。{概要} と書いた場所に入る
  '概要': `申請者：{申請者名}（{申請本部}）
稼働メンバー：{稼働メンバー}（{稼働先本部}）
期間：{開始日}〜{終了日}（予定{予定時間}時間）`,

  '承認依頼': {
    'タイトル': '【承認依頼】他部門稼働 {管理ID}',
    '本文': `{承認者名}さん、{申請者名}さんから承認依頼です。{注意書き}

{概要}
