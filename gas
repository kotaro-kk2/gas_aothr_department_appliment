// ===== 初期設定（手動で実行） =====
// 管理列・プルダウン・保護・成果報告URL・トリガーを用意する。何度実行してもよい
function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const apply = ss.getSheetByName(CONFIG.SHEET_APPLY);
  const result = ss.getSheetByName(CONFIG.SHEET_RESULT);
  if (!apply || !result) {
    throw new Error(`シート「${CONFIG.SHEET_APPLY}」と「${CONFIG.SHEET_RESULT}」が必要です。フォームの回答先をこのスプレッドシートにし、回答シートの名前を変更してください。`);
  }
  requireCols_(columns_(apply), Object.values(F));
  requireCols_(columns_(result), Object.values(R));

  // 管理列を右端に追加
  M_ORDER.forEach(h => {
    if (columns_(apply)[h]) return;
    const c = apply.getLastColumn() + 1;
    if (c > apply.getMaxColumns()) apply.insertColumnsAfter(apply.getMaxColumns(), c - apply.getMaxColumns());
    apply.getRange(1, c).setValue(h);
  });
  const cols = columns_(apply);
  if (apply.getMaxRows() < CONFIG.PREPARED_ROWS) {
    apply.insertRowsAfter(apply.getMaxRows(), CONFIG.PREPARED_ROWS - apply.getMaxRows());
  }
  const n = apply.getMaxRows() - 1;
  apply.getRange(1, 1, 1, apply.getLastColumn()).setFontWeight('bold');
  apply.setFrozenRows(1);
  apply.getRange(2, cols[M.STATUS], n, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireValueInList([S.PENDING, S.APPROVED, S.REJECTED, S.NOT_REQUIRED], true)
      .setAllowInvalid(false).build());
  [M.APPROVED_AT, M.REPORTED_AT].forEach(h => apply.getRange(2, cols[h], n, 1).setNumberFormat('yyyy/mm/dd hh:mm'));

  // setup より前に届いていた申請に管理IDを振る（通知はしない）
  const filled = backfill_(apply, cols);

  // 保護：申請回答は「承認ステータス」「却下理由」だけ編集可、成果回答は編集不可
  [apply, result].forEach(sh => sh.getProtections(SpreadsheetApp.ProtectionType.SHEET).forEach(p => p.remove()));
  const pa = apply.protect().setDescription('他部門稼働：承認ステータスと却下理由以外は編集不可');
  pa.setUnprotectedRanges([apply.getRange(2, cols[M.STATUS], n, 1), apply.getRange(2, cols[M.REASON], n, 1)]);
  ownerOnly_(pa);
  ownerOnly_(result.protect().setDescription('他部門稼働：成果報告フォームの回答（編集不可）'));

  // 成果報告フォームの「管理ID入力済みURL」
  PropertiesService.getScriptProperties().setProperty('RESULT_FORM_URL', buildPrefilledUrl_(result));

  // トリガー（重複しないよう作り直す）
  const handlers = ['handleFormSubmit', 'handleEdit', 'dailyReminder'];
  ScriptApp.getProjectTriggers().forEach(t => { if (handlers.indexOf(t.getHandlerFunction()) >= 0) ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('handleFormSubmit').forSpreadsheet(ss).onFormSubmit().create();
  ScriptApp.newTrigger('handleEdit').forSpreadsheet(ss).onEdit().create();
  ScriptApp.newTrigger('dailyReminder').timeBased().everyDays(1).atHour(CONFIG.REMIND_HOUR).create();

  const noId = MANAGERS.filter(m => !/^\d+$/.test(String(m.accountId || '').trim())).map(m => m.dept);
  if (noId.length) console.warn(`部長一覧で accountId が未設定の部門：${noId.join('、')}（メンションなしで通知します）`);
  console.log(`初期設定が完了しました。既存の申請 ${filled} 件に管理IDを振りました。` +
    `Chatwork通知：${chatworkEnabled_() ? 'あり' : 'なし（投稿内容は実行ログに出ます）'}`);
}

function backfill_(sheet, cols) {
  let count = 0;
  withLock_(() => {
    for (let row = 2; row <= sheet.getLastRow(); row++) {
      const rec = readRow_(sheet, cols, row);
      if (rec[M.ID] || !rec[F.TIMESTAMP]) continue;
      const status = Number(rec[F.HOURS]) <= CONFIG.NO_APPROVAL_MAX_HOURS ? S.NOT_REQUIRED : S.PENDING;
      const id = nextId_();
      writeRow_(sheet, cols, row, { [M.ID]: id, [M.STATUS]: status, [M.RESULT_STATUS]: RS.NONE });
      setStatus_(id, status);
      count++;
    }
  });
  return count;
}

function ownerOnly_(protection) {
  protection.addEditor(Session.getEffectiveUser());
  protection.removeEditors(protection.getEditors());
  if (protection.canDomainEdit()) protection.setDomainEdit(false);
}

function buildPrefilledUrl_(resultSheet) {
  const url = resultSheet.getFormUrl();
  if (!url) throw new Error(`シート「${resultSheet.getName()}」に成果報告フォームが連携されていません。`);
  const form = FormApp.openByUrl(url);
  const item = form.getItems(FormApp.ItemType.TEXT).filter(i => i.getTitle() === R.ID)[0];
  if (!item) throw new Error(`成果報告フォームに記述式の設問「${R.ID}」がありません。`);
  return form.createResponse().withItemResponse(item.asTextItem().createResponse(ID_MARK)).toPrefilledUrl();
}


// ===== 共通処理 =====
function applySheet_() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.SHEET_APPLY);
  if (!sh) throw new Error(`シート「${CONFIG.SHEET_APPLY}」がありません。`);
  return sh;
}

// 見出し名 → 列番号（1始まり）
function columns_(sheet) {
  const width = sheet.getLastColumn();
  const cols = {};
  if (width < 1) return cols;
  sheet.getRange(1, 1, 1, width).getValues()[0].forEach((h, i) => {
    const k = String(h).trim();
    if (k && !cols[k]) cols[k] = i + 1;
  });
  return cols;
}

function requireCols_(cols, names) {
  const missing = names.filter(n => !cols[n]);
  if (missing.length) {
    throw new Error(`見出し「${missing.join('」「')}」が見つかりません。フォームの設問名を確認するか、setup を実行してください。`);
  }
}

function readRow_(sheet, cols, row) {
  const values = sheet.getRange(row, 1, 1, sheet.getLastColumn()).getValues()[0];
  const rec = { _row: row };
  Object.keys(cols).forEach(k => { rec[k] = values[cols[k] - 1]; });
  return rec;
}

function writeRow_(sheet, cols, row, updates) {
  Object.keys(updates).forEach(k => sheet.getRange(row, cols[k]).setValue(updates[k]));
}

function findRowById_(sheet, cols, id) {
  if (!id || sheet.getLastRow() < 2) return null;
  const cell = sheet.getRange(2, cols[M.ID], sheet.getLastRow() - 1, 1)
    .createTextFinder(id).matchEntireCell(true).findNext();
  return cell ? cell.getRow() : null;
}

function rowLink_(sheet, row, col) {
  return `${sheet.getParent().getUrl()}#gid=${sheet.getSheetId()}&range=${sheet.getRange(row, col).getA1Notation()}`;
}

function resultUrl_(id) {
  const url = PropertiesService.getScriptProperties().getProperty('RESULT_FORM_URL');
  if (!url) throw new Error('成果報告フォームのURLが未設定です。setup を実行してください。');
  return url.replace(ID_MARK, encodeURIComponent(id));
}

// 承認ステータスの正しい値は、シートとは別にスクリプト プロパティにも持つ（勝手な書き換えを元に戻すため）
function currentStatus_(id, rec) {
  const v = PropertiesService.getScriptProperties().getProperty('ST:' + id);
  if (v !== null) return v;
  return rec[M.APPROVED_AT] ? String(rec[M.STATUS]) : S.PENDING;
}

function setStatus_(id, value) {
  PropertiesService.getScriptProperties().setProperty('ST:' + id, value);
}

function nextId_() {
  const p = PropertiesService.getScriptProperties();
  const seq = Number(p.getProperty('SEQ') || 0) + 1;
  p.setProperty('SEQ', String(seq));
  return 'W' + String(seq).padStart(4, '0');
}

function isAdmin_(email) {
  const owner = Session.getEffectiveUser().getEmail();
  return !!email && !!owner && email.toLowerCase() === owner.toLowerCase();
}

function firstTime_(key) {
  return withLock_(() => {
    const cache = CacheService.getScriptCache();
    if (cache.get(key)) return false;
    cache.put(key, '1', 21600);
    return true;
  });
}

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try { return fn(); } finally { lock.releaseLock(); }
}

// 「制作部（田中）」→ { dept: '制作部', head: '田中' }
function dept_(value) {
  const s = String(value || '').trim();
  const m = s.match(/^(.+?)\s*[（(]\s*(.+?)\s*[）)]$/);
  return m ? { dept: m[1], head: m[2] } : { dept: s, head: '' };
}

function person_(value) {
  const d = dept_(value);
  const m = manager_(value);
  const name = (m && m.name) || d.head;
  return name ? name + 'さん' : d.dept + 'の部長';
}

// 部門の値（「制作部（田中）」や「制作部」）から、部長一覧の行を探す
function manager_(value) {
  const d = dept_(value).dept;
  return MANAGERS.filter(m => m.dept === d)[0] || null;
}

// 部門の値を受け取り、その部長あての「[To:ID]名前さん」を作る（同じ人は1回だけ。IDが空なら付けない）
function mention_(...values) {
  const seen = {};
  const lines = [];
  values.forEach(v => {
    const m = manager_(v);
    const id = m ? String(m.accountId || '').trim() : '';
    if (!/^\d+$/.test(id) || seen[id]) return;
    seen[id] = true;
    lines.push(`[To:${id}]${m.name}さん`);
  });
  return lines.length ? lines.join('\n') + '\n' : '';
}

function applyPerson_(rec) { return person_(rec[F.APPLY_DEPT]); }
function targetPerson_(rec) { return person_(rec[F.TARGET_DEPT]); }

function fmt_(d, pattern) {
  return d instanceof Date ? Utilities.formatDate(d, CONFIG.TIMEZONE, pattern) : String(d || '');
}

function startOfDay_(d) {
  const x = new Date(d);
  x.setHours(0, 0, 0, 0);
  return x;
}

function addDays_(d, n) {
  const x = new Date(d);
  x.setDate(x.getDate() + n);
  return x;
}


