/**
 * 他部門稼働 申請・承認・成果報告（職務権限 No.43）【処理】
 * 設定（CONFIG・F・R・REQUIRED_F・REQUIRED_R・MASTER・MENTIONS・NOTIFY・MESSAGES）は、別の設定ファイルに書く
 *
 * しくみ
 *   申請フォーム → シート「申請回答」
 *     ・回答者のメールアドレスから、マスタで申請者名を補完する
 *     ・稼働期間が上限（CONFIG.MAX_BUSINESS_DAYS 営業日）を超えたら、自動で却下する
 *     ・それ以外は、申請者が選んだ本部の承認者に、Chatworkで承認依頼を送る
 *   承認 → 「承認ステータス」で「承認」「却下」「修正」のどれかを選ぶ
 *     ・却下：「理由（却下・修正）」の入力が必須
 *     ・修正：理由は任意（直してほしい点を一覧から選べる）
 *     ・却下も修正も、その申請はそこで終わり。申請者が新しく申請し直す
 *   成果報告フォーム → シート「成果回答」
 *     ・申請者本人（またはその本部の承認者・管理者）による、承認済みの申請への報告だけを転記する
 *     ・転記できなかった報告は、「処理結果（自動）」列に理由を残し、Chatworkで知らせる
 *   毎朝 → 取りこぼした申請・報告の再処理、送れなかった通知の再送、成果報告の督促
 *
 * エディタから手で実行する関数
 *   setup（初期設定。何度実行してもよい）／reprocessPending（取りこぼしの再処理）／
 *   retryFailedNotifications（通知の再送）／testChatwork（実際に送信して接続を確認）／
 *   listChatworkMembers／previewMessages／checkLatestApplication（この3つは送信しない）
 */

// ===== 申請回答シートの右側に足す管理列（この順で追加する） =====
const M = {
  ID: '管理ID',
  APPLICANT_NAME: '申請者名（自動）',
  STATUS: '承認ステータス',
  REASON: '理由（却下・修正）',
  APPROVER: '承認者',
  APPROVED_AT: '承認日時',
  RESULT_STATUS: '成果入力ステータス',
  ACTUAL: '実績日数',
  RESULT: '成果内容',
  BIKOU: '成果備考',
  REPORTED_AT: '成果報告日時',
};
const M_ORDER = Object.values(M);
// 以前の版の列名 → 今の列名（setup で見出しを書き換える）
const RENAMED = { '却下理由': M.REASON };
// 成果回答シートの右側に足す列
const RM = { RESULT: '処理結果（自動）' };

const S = { PENDING: '申請中', APPROVED: '承認', REJECTED: '却下', REVISE: '修正' };
const DECISIONS = [S.APPROVED, S.REJECTED, S.REVISE];
const RS = { NONE: '未入力', DONE: '入力完了' };
const AUTO_APPROVER = '（自動判定）';   // 稼働期間の上限超えで自動却下したときの「承認者」欄
const ID_MARK = 'ZZIDZZ';
// 設定の NOTIFY・MENTIONS・MESSAGES に必要な通知の種類
const KINDS = ['承認依頼', '承認', '却下', '修正', '成果報告', '督促'];
const ERR_HEADERS = ['発生日時', '状態', '再送日時', '種類', '管理ID', 'エラーの内容', '送る予定だった内容'];
const PROTECT_PREFIX = '他部門稼働：';


// ===== トリガー：フォーム送信時 =====
function handleFormSubmit(e) {
  if (!e || !e.range) throw new Error('この関数はフォーム送信で自動的に動きます。エディタから実行せず、フォームから送信して試してください。');
  const sheet = e.range.getSheet();
  const name = sheet.getName();
  if (name !== CONFIG.SHEET_APPLY && name !== CONFIG.SHEET_RESULT) return;
  checkConfig_();
  // 同じ行は一度しか処理しない（申請は管理ID、成果報告は「処理結果（自動）」で判定する）
  if (name === CONFIG.SHEET_APPLY) acceptApplication_(sheet, e.range.getRow(), true);
  else acceptResult_(sheet, e.range.getRow(), true);
}


// ===== 申請の受付（フォーム送信時と、取りこぼしの再処理で共通） =====
// 管理IDは最後に書く。途中で止まっても、管理IDのない行として再処理できるようにするため
function acceptApplication_(sheet, row, notify) {
  const cols = columns_(sheet);
  requireCols_(cols, usedF_().concat(M_ORDER), 'フォームの設問名（F）を確認するか、setup を実行してください。');
  const out = withLock_(() => {
    const r = readRow_(sheet, cols, row);
    if (r[M.ID] || !r[F.TIMESTAMP]) return null; // 処理済み、または空の行
    const p = personByMail_(r[F.EMAIL], MASTER.APPLICANT);
    const period = periodCheck_(r);
    const status = period.reject ? S.REJECTED : S.PENDING;
    const id = nextId_();
    writeRow_(sheet, cols, row, {
      [M.APPLICANT_NAME]: p ? p.name : '（マスタ未登録）',
      [M.STATUS]: status,
      [M.REASON]: period.reject,
      [M.APPROVER]: period.reject ? AUTO_APPROVER : '',
      [M.APPROVED_AT]: period.reject ? new Date() : '',
      [M.RESULT_STATUS]: RS.NONE,
    });
    setStatus_(id, status);
    writeRow_(sheet, cols, row, { [M.ID]: id });
    return { rec: readRow_(sheet, cols, row), note: period.note };
  });
  if (!out) return null;
  if (notify) {
    const rec = out.rec;
    if (rec[M.STATUS] === S.REJECTED) postChatwork_(message_('却下', rec), '却下', rec[M.ID]);
    else postChatwork_(message_('承認依頼', rec, {
      'シートのリンク': rowLink_(sheet, row, cols[M.STATUS]),
      '注意書き': applicationNotes_(rec) + out.note,
    }), '承認依頼', rec[M.ID]);
  }
  return out.rec;
}

// 稼働期間の確認。{ reject: 却下理由（問題なければ ''）, note: 承認依頼に添える注意書き }
function periodCheck_(r) {
  const s = r[F.START], e = r[F.END];
  if (!(s instanceof Date) || !(e instanceof Date)) {
    return { reject: '', note: '\n※稼働開始日・終了日を日付として読めないため、期間を自動で確認していません。' };
  }
  const start = startOfDay_(s), end = startOfDay_(e);
  if (end < start) return { reject: '稼働終了日が稼働開始日より前になっています。日付を確認して、申請し直してください。', note: '' };
  if ((end - start) / 86400000 > 366) return { reject: '稼働期間が1年を超えています。日付（特に年）を確認して、申請し直してください。', note: '' };
  const max = Number(CONFIG.MAX_BUSINESS_DAYS);
  if (!(max > 0)) return { reject: '', note: '' };
  const h = holidays_(start, end);
  const n = countBusinessDays_(start, end, h.set);
  if (n <= max) return { reject: '', note: h.ok ? '' : `\n※祝日を確認できなかったため、土日だけを除いて数えています（${n}営業日）。` };
  if (!h.ok) {
    return { reject: '', note: `\n※祝日を確認できなかったため、自動で却下していません。土日だけを除くと${n}営業日で、上限（${max}営業日）を超えています。期間を確認して判断してください。` };
  }
  return { reject: `稼働期間が${n}営業日あり、上限の${max}営業日を超えています。${max}営業日以内にして、申請し直してください。`, note: '' };
}

// 期間内の祝日。{ set: { 'yyyy-MM-dd': true }, ok: 読めたか }
function holidays_(start, end) {
  if (!CONFIG.SKIP_HOLIDAYS) return { set: {}, ok: true };
  try {
    const cal = CalendarApp.getCalendarById(CONFIG.HOLIDAY_CALENDAR_ID);
    if (!cal) return { set: {}, ok: false };
    const set = {};
    cal.getEvents(start, addDays_(end, 1)).forEach(ev => { set[fmt_(ev.getAllDayStartDate(), 'yyyy-MM-dd')] = true; });
    return { set: set, ok: true };
  } catch (err) {
    console.warn('祝日カレンダーを読めませんでした：' + err);
    return { set: {}, ok: false };
  }
}

// 開始日から終了日までの営業日数（両端を含む。土日と、渡された祝日を除く）
function countBusinessDays_(start, end, holidaySet) {
  let n = 0;
  for (let d = new Date(start); d <= end; d = addDays_(d, 1)) {
    const w = d.getDay();
    if (w === 0 || w === 6 || holidaySet[fmt_(d, 'yyyy-MM-dd')]) continue;
    n++;
  }
  return n;
}


// ===== 成果報告の受付（フォーム送信時と、取りこぼしの再処理で共通） =====
// 条件に合う報告だけを申請回答シートに転記し、成果回答シートの「処理結果（自動）」に結果を残す
function acceptResult_(resultSheet, row, notify) {
  const rcols = columns_(resultSheet);
  requireCols_(rcols, usedR_().concat([RM.RESULT]), 'フォームの設問名（R）を確認するか、setup を実行してください。');
  const apply = applySheet_();
  const cols = columns_(apply);
  const out = withLock_(() => {
    const r = readRow_(resultSheet, rcols, row);
    if (String(r[RM.RESULT] || '').trim()) return null;                   // 処理済み
    if (!String(r[R.ID] || '').trim() && !String(r[R.RESULT] || '').trim()) return null; // 空の行
    const id = String(r[R.ID] || '').trim().toUpperCase();
    const target = findRowById_(apply, cols, id);
    const rec = target ? readRow_(apply, cols, target) : null;
    const reporter = hasR_('EMAIL') ? String(r[R.EMAIL] || '').trim() : '';
    const problem = resultProblem_(r, rec, reporter);
    const mark = text => resultSheet.getRange(row, rcols[RM.RESULT]).setValue(text);
    if (problem) {
      mark('要確認：' + problem);
      return { ok: false, id: id, reporter: reporter, problem: problem };
    }
    const again = rec[M.RESULT_STATUS] === RS.DONE;
    writeRow_(apply, cols, target, {
      [M.ACTUAL]: Number(String(r[R.ACTUAL]).trim()),
      [M.RESULT]: String(r[R.RESULT] || '').trim(),
      [M.REPORTED_AT]: new Date(),
      [M.RESULT_STATUS]: RS.DONE,
    });
      if (hasR_('BIKOU')) writeRow_(apply, cols, target, { [M.BIKOU]: String(r[R.BIKOU] || '').trim() });   // ← 追加
    mark(again ? '反映済み（再提出）' : '反映済み');
    return { ok: true, rec: readRow_(apply, cols, target), again: again };
  });
  if (!out || !notify) return out;
  if (!out.ok) {
    postChatwork_(`[info][title]【要確認】成果報告を反映できませんでした[/title]` +
      `管理ID：${out.id || '（空欄）'}\n報告者：${nameByMail_(out.reporter) || '不明'}\n理由：${out.problem}\n` +
      `「${CONFIG.SHEET_RESULT}」シートの「${RM.RESULT}」列を確認してください。[/info]`, '要確認', out.id);
  } else {
    postChatwork_(message_('成果報告', out.rec, { '再提出': out.again ? '（再提出）' : '' }), '成果報告', out.rec[M.ID]);
  }
  return out;
}

// 成果報告を転記してよいか。問題がなければ ''、あれば理由を返す
function resultProblem_(r, rec, reporter) {
  if (!rec) return '管理IDが申請回答シートにありません。';
  const who = reporter.toLowerCase();
  if (hasR_('EMAIL') && who !== String(rec[F.EMAIL] || '').trim().toLowerCase() && !isApproverFor_(who, rec) && !isAdmin_(who)) {
    return '報告者が、この申請の申請者でも承認者でもありません（管理IDの入力間違いの可能性があります）。';
  }
  const st = currentStatus_(rec[M.ID], rec);
  if (st !== S.APPROVED) return `承認ステータスが「${st}」の申請です。成果報告できるのは承認済みの申請だけです。`;
  const t = String(r[R.ACTUAL] === null || r[R.ACTUAL] === undefined ? '' : r[R.ACTUAL]).trim();
  if (t === '' || !isFinite(Number(t)) || Number(t) < 0) return `実績（${t || '空欄'}）が0以上の数字ではありません。`;
  if (!String(r[R.RESULT] || '').trim()) return '成果内容が空欄です。';
  return '';
}


// ===== トリガー：編集時（承認・却下・修正） =====
function handleEdit(e) {
  if (!e || !e.range) throw new Error('この関数はシートの編集で自動的に動きます。エディタから実行せず、承認ステータスを選んで試してください。');
  const range = e.range;
  const sheet = range.getSheet();
  if (sheet.getName() !== CONFIG.SHEET_APPLY) return;
  const cols = columns_(sheet);
  const sc = cols[M.STATUS];
  if (!sc || sc < range.getColumn() || sc > range.getLastColumn()) return;
  const firstRow = Math.max(2, range.getRow());
  const lastRow = range.getLastRow();
  if (lastRow < firstRow) return;
  checkConfig_();

  const editor = String((e.user && e.user.getEmail && e.user.getEmail()) || '').trim();
  const bulk = range.getNumRows() > 1 || range.getNumColumns() > 1;
  const out = withLock_(() => bulk
    ? bulkEdit_(sheet, cols, firstRow, lastRow, editor)
    : statusEdit_(sheet, cols, firstRow, editor, e.value));
  if (out && out.body) postChatwork_(out.body, out.kind, out.id);
}

// 1セルの変更：承認・却下・修正を記録するか、無効なら元に戻す
//   chosen は、この編集で選ばれた値（e.value）。シートを読み直した値ではなく、操作した人が選んだ値で判定する
function statusEdit_(sheet, cols, row, editor, chosen) {
  const rec = readRow_(sheet, cols, row);
  const id = rec[M.ID];
  const cell = sheet.getRange(row, cols[M.STATUS]);
  const current = String(rec[M.STATUS] || '').trim();
  const value = chosen === undefined || chosen === null ? '' : String(chosen).trim();
  if (!id) { if (current) cell.setValue(''); return null; }
  const truth = currentStatus_(id, rec);
  const link = rowLink_(sheet, row, cols[M.STATUS]);
  const revert = (title, detail) => {
    cell.setValue(truth);
    return { kind: '管理', id: id, body: `[info][title]【取り消し】${id} ${title}[/title]${detail}\n${link}[/info]` };
  };

  // 同じセルが続けて操作され、この操作の値がもう残っていない
  if (current !== value) {
    if (current === truth) return null; // 先に処理された操作で、すでに元に戻っている
    return revert('の承認ステータスが続けて変更されたため、元に戻しました',
      `操作した人：${nameByMail_(editor) || '不明'}\nもう一度、1人だけで選び直してください。`);
  }
  if (value === truth) return null;

  const admin = isAdmin_(editor);
  let error = '';
  if (!editor) error = '操作した人のアカウントを確認できませんでした。';
  else if (!admin && truth !== S.PENDING) error = `この申請はすでに「${truth}」です。`;
  else if (DECISIONS.indexOf(value) < 0 && !(admin && value === S.PENDING)) error = `「${value || '空欄'}」には変更できません。「${DECISIONS.join('」「')}」のどれかを選んでください。`;
  else if (!admin && editor.toLowerCase() === String(rec[F.EMAIL]).trim().toLowerCase()) error = '申請者本人は操作できません。';
  else if (!admin && CONFIG.ONLY_MASTER_APPROVER && !isApproverFor_(editor, rec)) {
    error = `操作できるのは、${honbuName_(rec[F.APPLY_HONBU])}の承認者（マスタに登録された人）だけです。`;
  } else if (value === S.REJECTED && !String(rec[M.REASON] || '').trim()) {
    error = `却下するときは、先に「${M.REASON}」を入力してください。`;
  }
  if (error) {
    return revert('の承認ステータスの変更を元に戻しました',
      `操作した人：${nameByMail_(editor) || '不明'}\n選ばれた値：${value || '空欄'}\n理由：${error}`);
  }

  setStatus_(id, value);
  if (value === S.PENDING) { // 管理者が申請中に戻した
    writeRow_(sheet, cols, row, { [M.APPROVER]: '', [M.APPROVED_AT]: '' });
    return { kind: '管理', id: id, body: `[info][title]【管理者による変更】${id} を「${S.PENDING}」に戻しました[/title]操作した人：${nameByMail_(editor)}\n${link}[/info]` };
  }
  return decide_(sheet, cols, rec, value, editor);
}

// 複数セルをまとめて変えた場合：管理者も含めて全部元に戻す
// （承認者・日時の記録と通知は、1件ずつの変更でしか正しく行えないため）
function bulkEdit_(sheet, cols, firstRow, lastRow, editor) {
  const changed = [];
  for (let row = firstRow; row <= lastRow; row++) {
    const rec = readRow_(sheet, cols, row);
    const id = rec[M.ID];
    const value = String(rec[M.STATUS] || '').trim();
    const cell = sheet.getRange(row, cols[M.STATUS]);
    if (!id) { if (value) cell.setValue(''); continue; }
    const truth = currentStatus_(id, rec);
    if (value === truth) continue;
    cell.setValue(truth);
    changed.push(id);
  }
  if (!changed.length) return null;
  return { kind: '管理', id: changed.join('、'), body: `[info][title]【取り消し】複数のセルをまとめて変更したため、元に戻しました[/title]` +
    `操作した人：${nameByMail_(editor) || '不明'}\n対象：${changed.join('、')}\n` +
    `承認・却下・修正は、1件ずつプルダウンで選んでください。[/info]` };
}

// 承認・却下・修正の確定：承認者と日時を記録し、その種類の通知を作る
function decide_(sheet, cols, rec, value, editor) {
  const now = new Date();
  writeRow_(sheet, cols, rec._row, { [M.APPROVER]: editor, [M.APPROVED_AT]: now });
  rec[M.STATUS] = value;
  rec[M.APPROVER] = editor;
  rec[M.APPROVED_AT] = now;
  return { kind: value, id: rec[M.ID], body: message_(value, rec) };
}


// ===== トリガー：時間主導（毎朝） =====
function dailyReminder() {
  checkConfig_();
  safely_('取りこぼしの再処理', () => reprocessPending_(true));
  safely_('通知の再送', retryFailedNotifications);

  const today = startOfDay_(new Date());
  if (today.getDay() === 0 || today.getDay() === 6) return;
  if (!notifyEnabled_('督促')) return;
  const sheet = applySheet_();
  const cols = columns_(sheet);
  const last = sheet.getLastRow();
  if (last < 2) return;

  // 成果報告が遅れているもの（承認済みで、稼働終了日から REMIND_AFTER_DAYS 日たっても未入力）
  const values = sheet.getRange(2, 1, last - 1, sheet.getLastColumn()).getValues();
  const late = [];
  values.forEach((v, i) => {
    const rec = { _row: i + 2 };
    Object.keys(cols).forEach(k => { rec[k] = v[cols[k] - 1]; });
    if (!rec[M.ID] || rec[M.STATUS] !== S.APPROVED || rec[M.RESULT_STATUS] === RS.DONE || !(rec[F.END] instanceof Date)) return;
    if (today >= addDays_(startOfDay_(rec[F.END]), CONFIG.REMIND_AFTER_DAYS)) late.push(rec);
  });
  if (!late.length) return;

  const t = MESSAGES['督促'];
  const extra = { '件数': late.length };
  let people = [];
  late.forEach(rec => { people = people.concat(recipients_(rec, MENTIONS['督促'])); });
  postChatwork_(mentionText_(people) +
    `[info][title]${fill_(t['タイトル'], {}, extra)}[/title]${fill_(t['前置き'], {}, extra)}\n\n` +
    late.map(rec => fill_(t['行'], rec)).join('\n') + '[/info]', '督促', '');
}

// 取りこぼした申請・成果報告を処理する（手動で実行。毎朝も自動で実行される）
function reprocessPending() {
  checkConfig_();
  const n = reprocessPending_(true);
  console.log(`再処理：申請 ${n.applications} 件、成果報告 ${n.results} 件`);
}

function reprocessPending_(notify) {
  const apply = applySheet_();
  const cols = columns_(apply);
  const appRows = unprocessedRows_(apply, cols[F.TIMESTAMP], cols[M.ID]);
  appRows.forEach(row => acceptApplication_(apply, row, notify));
  const result = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.SHEET_RESULT);
  const rcols = result ? columns_(result) : {};
  const resRows = rcols[RM.RESULT] ? unprocessedRows_(result, 1, rcols[RM.RESULT]) : [];
  resRows.forEach(row => acceptResult_(result, row, notify));
  return { applications: appRows.length, results: resRows.length };
}

// keyCol が埋まっていて doneCol が空の行（＝未処理の行）の行番号を返す
function unprocessedRows_(sheet, keyCol, doneCol) {
  const last = sheet.getLastRow();
  if (last < 2 || !keyCol || !doneCol) return [];
  const values = sheet.getRange(2, 1, last - 1, Math.max(keyCol, doneCol)).getValues();
  const rows = [];
  values.forEach((v, i) => {
    if (String(v[keyCol - 1]).trim() !== '' && String(v[doneCol - 1]).trim() === '') rows.push(i + 2);
  });
  return rows;
}

function safely_(label, fn) {
  try { fn(); } catch (err) { console.error(`${label}で失敗しました：${err}`); }
}


// ===== 通知の組み立て =====
function notifyEnabled_(kind) {
  return NOTIFY[kind] !== false;
}

// 通知の種類ごとに、メンション（MENTIONS）と文面（MESSAGES）を組み合わせる。オフの通知は '' を返す
function message_(kind, rec, extra) {
  if (!notifyEnabled_(kind)) return '';
  return mentionText_(recipients_(rec, MENTIONS[kind])) + compose_(kind, rec, extra);
}

// MESSAGES の「タイトル」と「本文」に差し込みをして、枠付きの1通にする
function compose_(kind, rec, extra) {
  const t = MESSAGES[kind];
  return `[info][title]${fill_(t['タイトル'], rec, extra)}[/title]${fill_(t['本文'], rec, extra)}[/info]`;
}

// 文面の {名前} を、申請の内容に置き換える。一覧にない名前は {…} のまま残す（打ち間違いに気づけるように）
function fill_(template, rec, extra) {
  const reason = () => String(rec[M.REASON] || '').trim();
  const v = {
    '管理ID': () => rec[M.ID],
    '申請者名': () => applicantName_(rec),
    '申請者メール': () => rec[F.EMAIL],
    '申請本部': () => honbuName_(rec[F.APPLY_HONBU]),
    '承認者名': () => names_(approversOf_(rec[F.APPLY_HONBU])) || '（承認者未登録）',
    '稼働メンバー': () => rec[F.MEMBER],
    '稼働先本部': () => hasF_('TARGET_HONBU') ? honbuName_(rec[F.TARGET_HONBU]) : '',
    '稼働先承認者名': () => hasF_('TARGET_HONBU') ? names_(approversOf_(rec[F.TARGET_HONBU])) : '',
    '開始日': () => fmt_(rec[F.START], 'yyyy/MM/dd'),
    '終了日': () => fmt_(rec[F.END], 'yyyy/MM/dd'),
    '目的': () => hasF_('PURPOSE') ? rec[F.PURPOSE] : '',
    '予定時間': () => hasF_('HOURS') ? rec[F.HOURS] : '',   // 以前の版の文面との互換用
    '承認した人': () => nameByMail_(rec[M.APPROVER]),
    '理由': () => reason() || '（記載なし。承認者に確認してください）',
    '却下理由': () => reason() || '（記載なし。承認者に確認してください）',
    '実績日数': () => rec[M.ACTUAL],
    '成果内容': () => rec[M.RESULT],
    '成果備考': () => rec[M.BIKOU],
    '成果報告URL': () => resultUrl_(rec[M.ID]),
    '概要': () => fill_(MESSAGES['概要'], rec),
    '注意書き': () => '',
    '再提出': () => '',
    'シートのリンク': () => '',
    '件数': () => '',
  };
  Object.keys(extra || {}).forEach(k => { v[k] = () => extra[k]; });
  return String(template).replace(/\{([^{}\n]+)\}/g, (all, key) => {
    if (!v[key]) return all;
    const x = v[key]();
    return x === undefined || x === null ? '' : String(x);
  });
}

// MENTIONS の言葉（申請者／承認者／稼働先承認者）を、マスタの人に置き換える
function recipients_(rec, roles) {
  let people = [];
  (roles || []).forEach(role => {
    if (role === '申請者') {
      const p = personByMail_(rec[F.EMAIL], MASTER.APPLICANT);
      if (p) people.push(p);
    } else if (role === '承認者') {
      people = people.concat(approversOf_(rec[F.APPLY_HONBU]));
    } else if (role === '稼働先承認者') {
      if (hasF_('TARGET_HONBU')) people = people.concat(approversOf_(rec[F.TARGET_HONBU]));
    } else {
      console.warn(`MENTIONS に使えない言葉「${role}」があります（申請者／承認者／稼働先承認者のどれか）。`);
    }
  });
  return people;
}

// 人の一覧から「[To:ID]名前さん」を作る（同じ人は1回だけ。IDが空なら付けない）
function mentionText_(people) {
  const seen = {};
  const lines = [];
  people.forEach(p => {
    const id = String(p.cw || '').trim();
    if (!/^\d+$/.test(id) || seen[id]) return;
    seen[id] = true;
    lines.push(`[To:${id}]${p.name}さん`);
  });
  return lines.length ? lines.join('\n') + '\n' : '';
}

// 申請時の注意書き（マスタとの食い違いがあるときだけ）
function applicationNotes_(rec) {
  const notes = [];
  const p = personByMail_(rec[F.EMAIL], MASTER.APPLICANT);
  const honbu = honbuName_(rec[F.APPLY_HONBU]);
  if (!p) notes.push(`※申請者のメールアドレス（${rec[F.EMAIL] || '空欄'}）がマスタにありません。`);
  else if (p.honbu && honbu && p.honbu !== honbu) notes.push(`※マスタの本部（${p.honbu}）と、選ばれた本部（${honbu}）が違います。`);
  if (!approversOf_(rec[F.APPLY_HONBU]).length) notes.push(`※「${honbu || '空欄'}」の承認者がマスタに登録されていません。`);
  return notes.length ? '\n' + notes.join('\n') : '';
}


// ===== マスタの読み取り =====
let MASTER_CACHE_ = null;

// マスタの全行を読む（1回の実行につき1回だけ、まとめて読む）
function master_() {
  if (MASTER_CACHE_) return MASTER_CACHE_;
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(MASTER.SHEET);
  if (!sh) throw new Error(`シート「${MASTER.SHEET}」がありません。setup を実行してください。`);
  const cols = columns_(sh);
  requireCols_(cols, [MASTER.ROLE, MASTER.HONBU, MASTER.NAME, MASTER.MAIL, MASTER.CW_ID], 'マスタの1行目の見出しを確認してください。');
  const last = sh.getLastRow();
  const values = last < 2 ? [] : sh.getRange(2, 1, last - 1, sh.getLastColumn()).getValues();
  const get = (v, h) => { const x = v[cols[h] - 1]; return x === null || x === undefined ? '' : String(x).trim(); };
  MASTER_CACHE_ = values
    .map(v => ({
      role: get(v, MASTER.ROLE), honbu: get(v, MASTER.HONBU), name: get(v, MASTER.NAME),
      mail: get(v, MASTER.MAIL).toLowerCase(), cw: get(v, MASTER.CW_ID),
    }))
    .filter(p => p.mail || p.name);
  return MASTER_CACHE_;
}

// メールアドレスからマスタの人を探す（同じ人が複数行あれば、preferRole の区分を優先）
function personByMail_(mail, preferRole) {
  const m = String(mail || '').trim().toLowerCase();
  if (!m) return null;
  const hits = master_().filter(p => p.mail === m);
  return hits.filter(p => p.role === preferRole)[0] || hits[0] || null;
}

// 本部の承認者（区分が「承認者」の人）を全員返す
function approversOf_(honbuValue) {
  const h = honbuName_(honbuValue);
  if (!h) return [];
  return master_().filter(p => p.role === MASTER.APPROVER && p.honbu === h);
}

function isApproverFor_(mail, rec) {
  const m = String(mail || '').trim().toLowerCase();
  return !!m && approversOf_(rec[F.APPLY_HONBU]).some(p => p.mail === m);
}

// 申請者名は、申請時に保存した名前を使う（なければマスタから探す）
function applicantName_(rec) {
  const saved = String(rec[M.APPLICANT_NAME] || '').trim();
  if (saved && saved !== '（マスタ未登録）') return saved;
  const p = personByMail_(rec[F.EMAIL], MASTER.APPLICANT);
  return p ? p.name : `（マスタ未登録）${rec[F.EMAIL] || ''}`;
}

function nameByMail_(mail) {
  if (!mail) return '';
  const p = personByMail_(mail, MASTER.APPROVER);
  return p ? p.name : String(mail);
}

function names_(people) {
  return people.map(p => p.name).join('・');
}

// 本部の選択肢の値から本部名を取り出す（「営業本部（佐藤）」のように括弧が付いていても「営業本部」にする）
function honbuName_(value) {
  const s = String(value || '').trim();
  const m = s.match(/^(.+?)\s*[（(].*[）)]$/);
  return m ? m[1] : s;
}

// 管理者かどうか（設定の CONFIG.ADMIN_EMAILS に入っている人）
function isAdmin_(email) {
  const m = String(email || '').trim().toLowerCase();
  return !!m && CONFIG.ADMIN_EMAILS.map(x => String(x).trim().toLowerCase()).indexOf(m) >= 0;
}


// ===== Chatworkへの送信と、送れなかった通知の記録 =====
function chatworkEnabled_() {
  const p = PropertiesService.getScriptProperties();
  return !!(p.getProperty('CHATWORK_TOKEN') && p.getProperty('CHATWORK_ROOM_ID'));
}

// 1通送る。kind（通知の種類）と id（管理ID）は、失敗したときの記録と再送の判断に使う
function postChatwork_(body, kind, id) {
  if (!body) return;
  body = mentionHeader_() + body;
  if (!chatworkEnabled_()) {
    console.log('[Chatwork未設定のため、投稿内容をログに出力]\n' + body);
    return;
  }
  const err = sendChatwork_(body);
  if (err) {
    recordFailure_(body, err, kind, id);
    console.error(`Chatworkへの送信に失敗したため、「${CONFIG.SHEET_ERROR}」シートに記録しました：${err}`);
  }
}

// Chatworkに1通送る。成功なら ''、失敗なら理由を返す（エラーで止まらない）
function sendChatwork_(body) {
  try {
    const p = PropertiesService.getScriptProperties();
    const res = UrlFetchApp.fetch(`https://api.chatwork.com/v2/rooms/${p.getProperty('CHATWORK_ROOM_ID')}/messages`, {
      method: 'post',
      headers: { 'X-ChatWorkToken': p.getProperty('CHATWORK_TOKEN') },
      payload: { body: body },
      muteHttpExceptions: true,
    });
    const code = res.getResponseCode();
    return code >= 200 && code < 300 ? '' : `HTTP ${code}：${String(res.getContentText()).slice(0, 300)}`;
  } catch (e) {
    return String((e && e.message) || e);
  }
}

function recordFailure_(body, err, kind, id) {
  try {
    const sh = errorSheet_();
    const cols = columns_(sh);
    const row = new Array(sh.getLastColumn()).fill('');
    const put = (h, v) => { row[cols[h] - 1] = v; };
    put('発生日時', new Date()); put('状態', '未送信'); put('種類', kind || ''); put('管理ID', id || '');
    put('エラーの内容', err); put('送る予定だった内容', body);
    sh.appendRow(row);
  } catch (e) {
    console.error('通知エラーの記録にも失敗しました：' + e);
  }
}

// 「通知エラー」シート。なければ作り、足りない見出しは右端に足す
function errorSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(CONFIG.SHEET_ERROR);
  if (!sh) {
    sh = ss.insertSheet(CONFIG.SHEET_ERROR);
    sh.setFrozenRows(1);
  }
  ERR_HEADERS.forEach(h => {
    if (columns_(sh)[h]) return;
    const c = sh.getLastColumn() + 1;
    if (c > sh.getMaxColumns()) sh.insertColumnsAfter(sh.getMaxColumns(), c - sh.getMaxColumns());
    sh.getRange(1, c).setValue(h).setFontWeight('bold');
  });
  return sh;
}

// 「未送信」の通知を再送する（毎朝自動で実行。手動で実行してもよい）
//   承認依頼は、まだ「申請中」のときだけ送る。督促は翌朝に作り直されるので再送しない
function retryFailedNotifications() {
  if (!chatworkEnabled_()) return;
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.SHEET_ERROR);
  if (!sh || sh.getLastRow() < 2) return;
  const cols = columns_(sh);
  const values = sh.getRange(2, 1, sh.getLastRow() - 1, sh.getLastColumn()).getValues();
  const col = h => cols[h] - 1;
  let ok = 0, ng = 0, skip = 0;
  values.forEach((v, i) => {
    if (v[col('状態')] !== '未送信') return;
    const row = i + 2;
    const kind = cols['種類'] ? String(v[col('種類')]) : '';
    const id = cols['管理ID'] ? String(v[col('管理ID')]) : '';
    const setStatus = (status) => sh.getRange(row, cols['状態']).setValue(status);
    if (kind === '督促') { setStatus('再送不要（翌朝に作り直し）'); skip++; return; }
    if (kind === '承認依頼' && id && storedStatus_(id) !== S.PENDING) { setStatus('再送不要（対応済み）'); skip++; return; }
    const err = sendChatwork_(v[col('送る予定だった内容')]);
    if (!err) { setStatus('再送済み'); sh.getRange(row, cols['再送日時']).setValue(new Date()); ok++; }
    else { sh.getRange(row, cols['エラーの内容']).setValue(`${v[col('エラーの内容')]}\n${fmt_(new Date(), 'MM/dd HH:mm')} 再送も失敗：${err}`); ng++; }
  });
  if (ok || ng || skip) console.log(`通知の再送：成功 ${ok} 件、失敗 ${ng} 件、再送不要 ${skip} 件`);
}

// スクリプト プロパティ CHATWORK_TO（アカウントID。複数はカンマ区切り）があれば、先頭に [To:ID] を付ける（テスト用）
function mentionHeader_() {
  const raw = String(PropertiesService.getScriptProperties().getProperty('CHATWORK_TO') || '');
  const ids = raw.split(/[,、\s]+/).filter(Boolean);
  const bad = ids.filter(id => !/^\d+$/.test(id));
  if (bad.length) console.warn(`CHATWORK_TO に数字以外が含まれています（${bad.join('、')}）。アカウントIDは数字だけです。`);
  const good = ids.filter(id => /^\d+$/.test(id));
  return good.length ? good.map(id => `[To:${id}]`).join('') + '\n' : '';
}




function addColumn_(sheet, header) {
  if (columns_(sheet)[header]) return;
  const c = sheet.getLastColumn() + 1;
  if (c > sheet.getMaxColumns()) sheet.insertColumnsAfter(sheet.getMaxColumns(), c - sheet.getMaxColumns());
  sheet.getRange(1, c).setValue(header);
}

// マスタの準備と点検。なければ見出し付きで作って止まる。あれば保護して中身を点検する
function setupMaster_(ss) {
  let sh = ss.getSheetByName(MASTER.SHEET);
  if (!sh) {
    sh = ss.insertSheet(MASTER.SHEET);
    sh.getRange(1, 1, 1, 5).setValues([[MASTER.ROLE, MASTER.HONBU, MASTER.NAME, MASTER.MAIL, MASTER.CW_ID]]).setFontWeight('bold');
    sh.setFrozenRows(1);
    sh.getRange(2, 1, sh.getMaxRows() - 1, 1).setDataValidation(
      SpreadsheetApp.newDataValidation().requireValueInList([MASTER.APPLICANT, MASTER.APPROVER], true).build());
    sh.getRange(2, 5, sh.getMaxRows() - 1, 1).setNumberFormat('@');
    throw new Error(`シート「${MASTER.SHEET}」を作りました。申請者と承認者を入力してから、もう一度 setup を実行してください。`);
  }
  MASTER_CACHE_ = null;
  const list = master_();
  sh.getProtections(SpreadsheetApp.ProtectionType.SHEET)
    .filter(p => String(p.getDescription()).indexOf(PROTECT_PREFIX) === 0).forEach(p => p.remove());
  ownerOnly_(sh.protect().setDescription(PROTECT_PREFIX + 'マスタ（管理者のみ編集）'));

  const lines = [`マスタ：${list.length}人`];
  const badRole = list.filter(p => p.role !== MASTER.APPLICANT && p.role !== MASTER.APPROVER);
  if (badRole.length) lines.push(`注意：区分が「${MASTER.APPLICANT}」「${MASTER.APPROVER}」以外の行があります（${badRole.map(p => p.name).join('、')}）`);
  const honbus = list.filter(p => p.role === MASTER.APPROVER).map(p => p.honbu).filter((h, i, a) => h && a.indexOf(h) === i);
  lines.push(`承認者がいる本部：${honbus.join('、') || 'なし'}（申請フォームの本部の選択肢と同じ文字にしてください）`);
  const noId = list.filter(p => !/^\d+$/.test(p.cw));
  if (noId.length) lines.push(`注意：chatwork_account_ID が未入力の人（メンションなしで通知）：${noId.map(p => p.name).join('、')}`);
  const noMail = list.filter(p => !p.mail);
  if (noMail.length) lines.push(`注意：mail が未入力の人（申請者名の補完や承認の確認ができません）：${noMail.map(p => p.name).join('、')}`);
  return lines.join('\n');
}

function ownerOnly_(protection) {
  protection.addEditor(Session.getEffectiveUser());
  protection.removeEditors(protection.getEditors());
  if (protection.canDomainEdit()) protection.setDomainEdit(false);
}

function buildPrefilledUrl_(resultSheet) {
  const url = resultSheet.getFormUrl();
  if (!url) throw new Error(`シート「${resultSheet.getName()}」に成果報告フォームが連携されていません。`);
  const form = FormApp.openByUrl(url);
  const item = form.getItems(FormApp.ItemType.TEXT).filter(i => i.getTitle() === R.ID)[0];
  if (!item) throw new Error(`成果報告フォームに記述式の設問「${R.ID}」がありません。`);
  return form.createResponse().withItemResponse(item.asTextItem().createResponse(ID_MARK)).toPrefilledUrl();
}

// 設定ファイルに必要な項目がそろっているか確かめる。足りなければ、まとめて知らせる
function checkConfig_() {
  const p = [];
  REQUIRED_F.forEach(k => { if (!hasF_(k)) p.push(`F.${k}（設問名）`); });
  REQUIRED_R.forEach(k => { if (!hasR_(k)) p.push(`R.${k}（設問名）`); });
  if (typeof CONFIG.MAX_BUSINESS_DAYS !== 'number' || CONFIG.MAX_BUSINESS_DAYS < 0) p.push('CONFIG.MAX_BUSINESS_DAYS（稼働期間の上限の営業日。上限なしなら 0）');
  if (typeof CONFIG.SKIP_HOLIDAYS !== 'boolean') p.push('CONFIG.SKIP_HOLIDAYS（祝日を除くなら true、除かないなら false）');
  if (CONFIG.SKIP_HOLIDAYS === true && !String(CONFIG.HOLIDAY_CALENDAR_ID || '').trim()) p.push('CONFIG.HOLIDAY_CALENDAR_ID（祝日カレンダーのID）');
  if (!String(CONFIG.SHEET_ERROR || '').trim()) p.push('CONFIG.SHEET_ERROR（通知エラーを記録するシートの名前）');
  if (!Array.isArray(CONFIG.ADMIN_EMAILS) || !CONFIG.ADMIN_EMAILS.length) p.push('CONFIG.ADMIN_EMAILS（管理者のメールアドレスの一覧）');
  if (typeof NOTIFY === 'undefined') p.push('NOTIFY（通知のオン・オフ）');
  else KINDS.forEach(k => { if (typeof NOTIFY[k] !== 'boolean') p.push(`NOTIFY['${k}']（true か false）`); });
  KINDS.forEach(k => { if (!Array.isArray(MENTIONS[k])) p.push(`MENTIONS['${k}']（メンション先）`); });
  ['概要'].concat(KINDS).forEach(k => { if (!MESSAGES[k]) p.push(`MESSAGES['${k}']（文面）`); });
  if (p.length) throw new Error('設定ファイルに次の項目がないか、書き方が違います：\n・' + p.join('\n・') + '\n設定ファイルを直してから、もう一度実行してください。');
}

function hasF_(key) { return !!String(F[key] || '').trim(); }
function hasR_(key) { return !!String(R[key] || '').trim(); }
function usedF_() { return Object.keys(F).filter(hasF_).map(k => F[k]); }
function usedR_() { return Object.keys(R).filter(hasR_).map(k => R[k]); }


