  APPLY_HONBU: '',               // 必須：申請者の所属本部（ラジオボタン。選択肢はマスタの本部名と同じ文字にする）
  MEMBER: '',                    // 必須：稼働させたいメンバー
  TARGET_HONBU: '',              // 任意：稼働メンバーの所属本部（空なら、稼働先の本部への通知はしない）
  START: '',                     // 必須：稼働開始日（「日付」の設問）
  END: '',                       // 必須：稼働終了日（「日付」の設問）
